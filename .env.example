# Copy this file to .env in the project root before running Hardhat commands.
# Used by hardhat.config.js for the `sepolia` network.

# Sepolia RPC endpoint (Alchemy, Infura, or any provider). Despite the name,
# any Sepolia HTTPS RPC URL works here.
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployer wallet, used to sign deployment transactions.
# NEVER commit a real private key. Use a throwaway/test wallet for Sepolia.
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix
